{
    "name": "hexydec/versions",
    "description": "A list of browser version numbers, along with release dates",
    "type": "library",
    "license": "MIT",
	"autoload": {
		"classmap": ["src/", "dist/", "tests/"]
	},
    "authors": [
        {
            "name": "Hexydec",
            "email": "will@hexydec.com"
        }
    ],
    "minimum-stability": "beta",
    "require": {
        "php": ">=8.4",
        "hexydec/htmldoc": "1.9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "@php -d opcache.enable_cli=0 vendor/bin/phpstan analyse --memory-limit=512M",
        "build": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d xdebug.mode=off src/build.php"
        ]
    }
}
